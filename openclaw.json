{
  "gateway": {
    "mode": "local",
    "auth": {
      "token": "local-dev"
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "lmstudio/zai-org/glm-4.7-flash"
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "lmstudio": {
        "baseUrl": "http://host.docker.internal:1234/v1",
        "apiKey": "lmstudio",
        "api": "openai-completions",
        "models": [
          {
            "id": "zai-org/glm-4.7-flash",
            "name": "zai-org/glm-4.7-flash",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 200000,
            "maxTokens": 4096
          }
        ]
      }
    }
  }
}